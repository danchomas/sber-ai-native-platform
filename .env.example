# Окружение платформы.
#
#   cp .env.example .env
#
# docker-compose.yml не содержит ни одного собственного значения и без
# этого файла не поднимется. Это сделано намеренно: молча стартовать
# с учётными данными вроде aibi:aibi хуже, чем не стартовать вовсе.
#
# Файл читают двое: docker compose (подставляет значения в стенд) и само
# приложение через godotenv, когда его запускают локально через `make run`.

# ═══ Стенд: нужно только docker compose ═══════════════════════════════

# Порты на стороне хоста. Точка входа — FRONTEND_PORT.
FRONTEND_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
OLLAMA_PORT=11434

# Версия, вшиваемая в бинарник при сборке образа.
VERSION=local

# ── PostgreSQL ───────────────────────────────────────────────────────
# Учётные данные задаются здесь один раз: строку подключения для
# контейнеров compose собирает из них сам.
POSTGRES_USER=aibi
POSTGRES_PASSWORD=aibi
POSTGRES_DB=aibi
POSTGRES_INITDB_ARGS=--data-checksums

# Настройки под аналитическую нагрузку на одной машине.
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_PARALLEL_WORKERS=4
PG_JIT=off

# ═══ Приложение ═══════════════════════════════════════════════════════

# ── Общее ────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=info
LOG_JSON=false

# ── HTTP ─────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
# Необязательные пределы HTTP-сервера; ниже значения по умолчанию. 0 — без предела.
HTTP_READ_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=90s
HTTP_SHUTDOWN_TIMEOUT=15s
# Предел обработки одного запроса. Агент планирует SQL, выполняет его и
# при ошибке переписывает, поэтому на слабом железе ответ занимает минуты.
HTTP_REQUEST_TIMEOUT=300s
# Запись должна переживать самый долгий ответ, иначе клиент получит 502
# вместо результата. Проверяется при старте: должен быть больше предыдущего.
HTTP_WRITE_TIMEOUT=330s
HTTP_CORS_ORIGINS=*

# ── Подключение к базе ───────────────────────────────────────────────
# Адрес для ЛОКАЛЬНОГО запуска (`make run`): база видна на localhost.
# Контейнерам compose подставляет свою строку с хостом postgres, поэтому
# значение ниже на стенд не влияет.
DATABASE_URL=postgres://aibi:aibi@localhost:5432/aibi?sslmode=disable

# Схема, в которую материализуются загруженные CSV.
RAW_SCHEMA=raw

# Роль, от которой выполняются аналитические запросы к данным платформы.
# Её создаёт само приложение при старте: только SELECT на RAW_SCHEMA,
# read-only по умолчанию, пароль случайный на каждый запуск. Даже запрос,
# обошедший проверки, не прочитает ключи провайдеров и ничего не изменит.
# Пустое значение отключает роль — тогда запросы идут от владельца базы.
# Владельцу нужно право CREATEROLE (суперпользователь в стенде его имеет).
PG_READER_ROLE=aibi_reader

PG_MAX_CONNS=16
PG_MIN_CONNS=2
PG_MAX_CONN_LIFETIME=1h
PG_MAX_CONN_IDLE_TIME=30m
PG_HEALTHCHECK_PERIOD=1m
PG_CONNECT_TIMEOUT=10s
PG_STATEMENT_TIMEOUT=60s

# ── Языковая модель (OpenAI-совместимый API) ─────────────────────────
# Локальный Ollama в стенде: http://ollama:11434/v1
# Он же при локальном запуске: http://localhost:11434/v1
# OpenRouter:                  https://openrouter.ai/api/v1
#
# Это модель по умолчанию. Её можно перекрыть на ходу через
# /api/v1/providers — там же подключается OpenRouter. Без единого
# включённого провайдера работает то, что задано здесь.
LLM_ENABLED=true
LLM_BASE_URL=http://ollama:11434/v1
# Требования к памяти при работе на процессоре:
#   qwen2.5-coder:3b  ~3 ГБ   — влезает почти везде, чаще ошибается в SQL
#   qwen2.5-coder:7b  ~6 ГБ   — разумный компромисс
#   qwen2.5-coder:14b ~10 ГБ  — заметно лучше, но нужна видеокарта
LLM_MODEL=qwen2.5-coder:7b
# Локальной модели ключ не нужен, но переменная должна быть объявлена:
# compose не поднимется, если про неё просто забыли.
# Для OpenRouter — ключ вида sk-or-v1-... Свой ключ держите только
# в .env: этот файл в репозиторий не входит.
LLM_API_KEY=
# Только для OpenRouter: какие провайдеры пробовать первыми, через запятую.
# Провайдеры одной модели по-разному разбирают вызовы инструментов: на
# qwen/qwen3.8-27b у Near AI аргументы корректны, у Wafer и ModelRun вложенные
# поля теряются. Пусто — маршрут выбирает OpenRouter.
LLM_PROVIDER_ORDER=
LLM_TIMEOUT=120s
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_RETRIES=2

# ── Загрузка CSV ─────────────────────────────────────────────────────
INGEST_MAX_UPLOAD_MB=512
INGEST_COPY_BATCH_ROWS=5000
INGEST_TYPE_SAMPLE_ROWS=2000
INGEST_PROFILE_TOP_VALUES=10

# ── Аналитические запросы ────────────────────────────────────────────
QUERY_MAX_ROWS=5000
QUERY_TIMEOUT=60s
QUERY_PREVIEW_ROWS=50
# Попытки переписать SQL после ошибки.
QUERY_MAX_REPAIRS=2
# Глубина контекста диалога (сообщений).
QUERY_HISTORY_DEPTH=12

# ── Агент ────────────────────────────────────────────────────────────
# Агент отвечает в цикле: модель вызывает инструменты платформы
# (описание данных, агрегаты, выборки, дашборды), видит результат
# и решает, что делать дальше. Это предел обращений за один вопрос.
AGENT_MAX_STEPS=10
# Модель не пишет SQL: она заполняет параметры инструментов, а запрос
# собирает и проверяет платформа. true открывает ей ещё и run_sql —
# свободный SELECT под проверкой sqlguard — для вопросов, которые не
# укладываются в инструменты. Для демонстрации оставляйте false.
AGENT_ALLOW_RAW_SQL=false
# Сколько вопросов агент обрабатывает одновременно. Остальные ждут
# AGENT_QUEUE_WAIT, затем получают «ассистент занят» (HTTP 429): так один
# клиент не займёт локальную модель целиком.
AGENT_MAX_CONCURRENT=4
AGENT_QUEUE_WAIT=30s

# Сколько удалённые дашборды и виджеты лежат в корзине, прежде чем стереться насовсем.
DASHBOARD_TRASH_RETENTION=24h
